# Copie para .env e mantenha o arquivo local.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=
# Preencha apenas ao migrar tokens gravados antes deste fork.
LEGACY_ENCRYPTION_KEY=

# Use o nome DNS do controlador que consta no certificado LDAPS.
AD_HOST=
AD_PORT=636
AD_BASE_DN=
# DN da conta de serviço com acesso somente de leitura.
AD_BIND_DN=
AD_BIND_PASSWORD=
# Caminho dentro do contêiner. Monte a CA em ./local-config/ad-ca.pem.
AD_CA_FILE=/run/totpvault/ad-ca.pem
# Grupo direto obrigatório para entrar. Vazio permite as contas da base.
AD_ACCESS_GROUP_DN=
# Grupo direto autorizado a administrar o cofre.
AD_ADMIN_GROUP_DN=

# O Compose publica a aplicação apenas em 127.0.0.1:8080.
# Use um proxy HTTPS local que sobrescreva X-Forwarded-Proto.
TRUST_TLS_PROXY=true
ALLOW_HTTP_DEV=false
