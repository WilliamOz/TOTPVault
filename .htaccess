Options -Indexes
RewriteEngine On

# Protect deployment files, hidden paths and PHP implementation details.
RewriteRule "(^|/)\." - [F]
RewriteRule "^(config|src|sessions|templates|tools/.+\.php|migrations|charts|docker|local-config)(/|$)" - [F,NC]
RewriteRule "^(schema\.sql|docker-compose\.yml|Dockerfile|Makefile|README\.md|SECURITY\.md|LICENSE)$" - [F,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
